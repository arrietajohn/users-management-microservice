{
  "info": {
    "name": "Taller de MicroServicios Spring Boot Hexagonal",
    "description": "Peticiones del microservicio users-management. Primero ejecuta 'Login', copia el accessToken y pegalo en la variable 'token' de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "PEGA_AQUI_EL_ACCESS_TOKEN" },
    { "key": "userId", "value": "33333333-3333-3333-3333-333333333333" }
  ],
  "item": [
    {
      "name": "Login (obtener JWT)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Listar usuarios",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{userId}}\",\n  \"name\": \"Usuario Boomerang\",\n  \"email\": \"boomerang@example.com\",\n  \"password\": \"Prueba1234!\",\n  \"role\": \"MEMBER\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Obtener usuario por Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "Actualizar usuario (activar)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuario Boomerang\",\n  \"email\": \"boomerang@example.com\",\n  \"password\": \"\",\n  \"role\": \"MEMBER\",\n  \"status\": \"ACTIVE\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Login usuario activado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"boomerang@example.com\",\n  \"password\": \"Prueba1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Eliminar usuario por Id",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    }
  ]
}

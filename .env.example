# Copie este archivo como .env en la raiz del proyecto y llene los valores.
# .env esta en .gitignore: nunca se sube al repositorio.
# Spring Boot lo carga con spring.config.import=optional:file:.env[.properties],
# por eso el proyecto debe ejecutarse con la raiz del repo como directorio de trabajo.

# Base de datos (local: MySQL 8.4 en el puerto 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# Correo SMTP de Gmail (contrasena de aplicacion de 16 caracteres, no la de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=REEMPLAZAR
SMTP_FROM_ADDRESS=tu-correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios

# JWT: Base64 de al menos 32 bytes aleatorios. Generar con: openssl rand -base64 32
JWT_SECRET=REEMPLAZAR
JWT_EXPIRATION_SECONDS=900
